# App server (inside the container). TLS and generic security headers are
# handled by Cloudflare and the edge Caddy in pi-infra.
{
	admin off
	auto_https off
	persist_config off
	http_port 8080
}

(headers) {
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		# No hashed file names: always revalidate (ETag makes it cheap),
		# so a deploy never mixes old and new modules.
		Cache-Control "no-cache"
	}
}

:8080 {
	root * /srv
	redir / /frontend/
	# Browsers ask for /favicon.ico regardless of the <link rel="icon">
	redir /favicon.ico /frontend/favicon.svg

	import headers
	file_server

	# Error responses run a separate route: headers again, then the 404 page
	# (file_server keeps the 404 status here)
	handle_errors 404 {
		import headers
		rewrite * /frontend/404.html
		file_server
	}
}
